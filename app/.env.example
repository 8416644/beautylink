# Copy this file to .env.local and fill in the values from the Supabase dashboard
# (Project Settings > API). Only the publishable key belongs in the app; never put
# the database password or a secret key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google sign-in: the Web client ID from Google Cloud (public; never the client secret).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
